{
  "schema_version": 2,
  "required_capabilities": ["custom_pages", "image_upload"],
  "pages": [
    {
      "id": "home",
      "title": "小花绘",
      "description": "角色库、插件设置与后续绘图模块的统一入口。",
      "icon": "puzzle",
      "mode": "custom",
      "entry": "webui/roles.html",
      "layout": "document",
      "queries": {
        "roles": {
          "api": "webui_roles",
          "version": "1",
          "parameters": {
            "query": {"type": "string", "max_length": 64},
            "page": {"type": "integer", "minimum": 1, "maximum": 100000},
            "page_size": {"type": "integer", "minimum": 1, "maximum": 24},
            "sort": {"type": "string", "choices": ["name", "updated"]}
          }
        },
        "detail": {
          "api": "webui_role_detail",
          "version": "1",
          "parameters": {
            "name": {"type": "string", "required": true, "max_length": 256}
          }
        },
        "thumbnail": {
          "api": "webui_role_thumbnail",
          "version": "1",
          "parameters": {
            "name": {"type": "string", "required": true, "max_length": 256}
          }
        },
        "settings": {
          "api": "webui_settings",
          "version": "1"
        },
        "config_export": {
          "api": "webui_config_export",
          "version": "1"
        },
        "drawing_api": {
          "api": "webui_drawing_api",
          "version": "1"
        },
        "current_tasks": {
          "api": "webui_current_tasks",
          "version": "1"
        },
        "task_history": {
          "api": "webui_task_history",
          "version": "1",
          "parameters": {
            "page": {"type": "integer", "minimum": 1, "maximum": 100000},
            "page_size": {"type": "integer", "minimum": 5, "maximum": 50},
            "status": {"type": "string", "choices": ["", "succeeded", "failed", "cancelled"]},
            "query": {"type": "string", "max_length": 128}
          }
        },
        "task_detail": {
          "api": "webui_task_detail",
          "version": "1",
          "parameters": {
            "task_id": {"type": "integer", "minimum": 0, "maximum": 2147483647, "required": true}
          }
        },
        "task_thumbnail": {
          "api": "webui_task_thumbnail",
          "version": "1",
          "parameters": {
            "task_id": {"type": "integer", "minimum": 0, "maximum": 2147483647, "required": true},
            "kind": {"type": "string", "choices": ["output", "reference"]},
            "size": {"type": "string", "choices": ["card", "detail"]}
          }
        }
      },
      "actions": {
        "save_settings": {
          "api": "webui_settings_save",
          "version": "1",
          "parameters": {
            "settings_json": {"type": "string", "required": true, "max_length": 65536}
          }
        },
        "save_drawing_api": {
          "api": "webui_drawing_api_save",
          "version": "1",
          "parameters": {
            "api_json": {"type": "string", "required": true, "max_length": 65536}
          }
        },
        "save_drawing_api_profile": {
          "api": "webui_drawing_api_save_profile",
          "version": "1",
          "parameters": {
            "api_json": {"type": "string", "required": true, "max_length": 65536}
          }
        },
        "activate_drawing_api": {
          "api": "webui_drawing_api_activate",
          "version": "1",
          "parameters": {
            "profile_id": {"type": "string", "required": true, "max_length": 64}
          }
        },
        "delete_drawing_api": {
          "api": "webui_drawing_api_delete",
          "version": "1",
          "parameters": {
            "profile_id": {"type": "string", "required": true, "max_length": 64}
          }
        },
        "fetch_models": {
          "api": "webui_drawing_models",
          "version": "1",
          "parameters": {
            "base_url": {"type": "string", "max_length": 2000},
            "api_key": {"type": "string", "max_length": 4000}
          }
        },
        "cancel_task": {
          "api": "webui_task_cancel",
          "version": "1",
          "parameters": {
            "task_id": {"type": "integer", "minimum": 0, "maximum": 2147483647, "required": true}
          }
        },
        "retry_task": {
          "api": "webui_task_retry",
          "version": "1",
          "parameters": {
            "task_id": {"type": "integer", "minimum": 0, "maximum": 2147483647, "required": true},
            "api_profile_id": {"type": "string", "max_length": 64}
          }
        },
        "delete_tasks": {
          "api": "webui_task_delete",
          "version": "1",
          "parameters": {
            "ids_json": {"type": "string", "required": true, "max_length": 65536}
          }
        },
        "delete": {
          "api": "webui_role_delete",
          "version": "1",
          "parameters": {
            "name": {"type": "string", "required": true, "max_length": 256}
          },
          "confirmation": "确认删除这个角色及其图片？此操作不可恢复。"
        },
        "rename": {
          "api": "webui_role_rename",
          "version": "1",
          "parameters": {
            "old_name": {"type": "string", "required": true, "max_length": 256},
            "new_name": {"type": "string", "required": true, "max_length": 256}
          }
        },
        "set_image": {
          "api": "webui_role_set_image",
          "version": "1",
          "parameters": {
            "upload_id": {"type": "string", "required": true, "max_length": 64},
            "name": {"type": "string", "required": true, "max_length": 256}
          },
          "confirmation": "确认保存这张图片？同名角色会被替换。"
        }
      },
      "uploads": {
        "role_image": {"action": "set_image", "image_max_edge": 2048}
      }
    }
  ]
}
