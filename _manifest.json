{
  "manifest_version": 2,
  "id": "suitun.little-flower-draw",
  "version": "0.9.0",
  "name": "小花绘",
  "description": "让小花帮你画",
  "author": {
    "name": "suitun",
    "url": "https://github.com/suitun"
  },
  "license": "LicenseRef-Proprietary",
  "urls": {
    "repository": "https://github.com/suitun/LittleFlowerDraw"
  },
  "host_application": {
    "min_version": "1.4.3",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.22.1",
    "max_version": "2.22.99"
  },
  "dependencies": [
    {"type": "python_package", "name": "pillow", "version_spec": ">=12.3.0"},
    {"type": "python_package", "name": "pydantic", "version_spec": ">=2.11.7,<3"}
  ],
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "palette"
    }
  },
  "capabilities": ["send.text", "send.image", "send.hybrid", "chat.open_session", "message.get_by_id", "api.get", "api.call", "webui.claim_upload"],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
